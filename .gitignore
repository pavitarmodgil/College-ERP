# Environment variables — NEVER commit real secrets
.env

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Build outputs (for future React/Vite frontend)
client/dist/
client/node_modules/

# Prisma generated client (Prisma 5 — lives in node_modules, no extra entry needed)
# Migrations ARE committed — they are permanent history

# ── AI/ML module (Phase 7) ──────────────────────────────────────────────────
# Datasets and model binaries are NOT committed — they are regenerated by
# ai/scripts/. The scripts and notebook that produce them ARE committed, which
# is what makes the pipeline reproducible. Extracted CSVs also contain real
# student academic records and must never reach source control.
ai/data/raw/*
ai/data/processed/*
ai/models/*
!ai/data/raw/.gitkeep
!ai/data/processed/.gitkeep
!ai/models/.gitkeep

# Python local environments / caches
ai/.venv/
ai/**/__pycache__/
*.py[cod]
.ipynb_checkpoints/

