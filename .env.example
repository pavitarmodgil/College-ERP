# ─────────────────────────────────────────────────────────────
#  University Management System — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000

# Session
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Phase 1 (MySQL / Prisma) ──────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/university_db"

# ── Phase 1 (MongoDB) ─────────────────────────────────────────
# MONGO_URI="mongodb://localhost:27017/ums_profiles"

# ── Phase 2 (Redis) ───────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Phase 2 (Email / Nodemailer) ─────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── Phase 2 (hCaptcha) ───────────────────────────────────────
# HCAPTCHA_SECRET=your-hcaptcha-secret-key
