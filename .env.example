# ─────────────────────────────────────────────────────────────
#  University Management System — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173   # Frontend origin for CORS; no trailing slash

# ── Database (PostgreSQL / Prisma) ───────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/university_db"

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-32-char-random-hex

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=          # Leave blank for local; required for Upstash in prod
# REDIS_TLS=true           # Uncomment for Upstash / any TLS-required Redis in prod

# ── Email (Resend HTTP API) ───────────────────────────────────
# Sign up at resend.com — Railway blocks SMTP ports so Nodemailer/Gmail won't work
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── hCaptcha ─────────────────────────────────────────────────
HCAPTCHA_SECRET=your-hcaptcha-secret-key
