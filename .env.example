# ─────────────────────────────────────────────────────────────
#  University Management System — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Legacy server.js (Phase 3 will retire this)
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Phase 2 — New API server ──────────────────────────────────
API_PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Phase 1 (MySQL / Prisma) ──────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/university_db"

# ── Phase 2 (JWT) ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-32-char-random-hex

# ── Phase 2 (Redis) ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=  (leave blank if no auth)

# ── Phase 2 (Gmail / Nodemailer) ─────────────────────────────
# Requires a Gmail App Password (not your normal password)
# Enable at: myaccount.google.com → Security → 2-Step → App passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Phase 2 (hCaptcha) ───────────────────────────────────────
HCAPTCHA_SECRET=your-hcaptcha-secret-key

# ── Phase 1 (MongoDB) — Phase 4 ───────────────────────────────
# MONGO_URI="mongodb://localhost:27017/ums_profiles"
